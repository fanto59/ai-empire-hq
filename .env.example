# AI EMPIRE HQ - example environment configuration.
# Copy to .env.local for local development. NEVER commit real values.
# The app runs with ZERO variables set: every integration defaults to disabled.

# Deployment stage label shown in the UI: development | staging | production
APP_ENV=development

# Master kill switch for real agent execution. Must stay "false" until the
# execution runtime, auth, and approval gates are built and reviewed.
AGENT_EXECUTION_ENABLED=false

# Model provider switches. A provider is used only when its switch is "true"
# AND its app key below is set. See docs/MODEL_PROVIDERS.md.
PROVIDER_ANTHROPIC_ENABLED=false
PROVIDER_OPENAI_ENABLED=false
PROVIDER_XAI_ENABLED=false

# The app's OWN API keys (only these variables are read; ANTHROPIC_*/OPENAI_*
# variables and Claude Code credentials are ignored). Set them in your
# environment or secret manager, never in a committed file.
# AEHQ_ANTHROPIC_API_KEY=     # Claude (engineering & complex execution)
# AEHQ_OPENAI_API_KEY=        # OpenAI (strategy & structured analysis)
# AEHQ_XAI_API_KEY=           # Grok   (research & trend monitoring)
# OBSIDIAN_VAULT_PATH=

# Knowledge vault (Markdown, Obsidian-compatible). Defaults to the committed
# sample vault. Put real vaults under ./vaults/ (git-ignored). Sync is off.
# KNOWLEDGE_VAULT_DIR=knowledge/sample-vault

# Operational database. Development default: embedded PostgreSQL in .data/.
# Production: a real server is required, e.g. postgres://user:pass@host:5432/aehq
# (put the real value in your hosting secret manager, never in git).
# DATABASE_URL=pglite:.data/pglite
# Organization shown in the dashboard (the seeded test org by default).
# AEHQ_ORGANIZATION=test-org

# ---- Agents — see docs/RESEARCH_AGENT.md and docs/MODEL_PROVIDERS.md ----
# Which model each agent uses is chosen on the /models page (not here).
# AGENT_EXECUTION_ENABLED=true     # master switch, plus a provider switch + key above
# AGENT_WORKER=in-process          # run the workers inside the web server
# RESEARCH_EFFORT=medium
# RESEARCH_ALLOWED_DOMAINS=wikipedia.org,wikimedia.org,nasa.gov,noaa.gov,britannica.com
# RESEARCH_MAX_COST_USD=1.00       # cap per task attempt (budgets still apply)
# RESEARCH_MAX_SEARCHES=5
# RESEARCH_MAX_FETCHES=3
