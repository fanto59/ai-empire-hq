{
  "name": "ai-empire-hq",
  "version": "0.1.0",
  "private": true,
  "description": "AI EMPIRE HQ - a secure, expandable multi-business AI headquarters.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "knowledge:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs scripts/knowledge/seed-sample-vault.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs scripts/db/migrate.ts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs scripts/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run knowledge:seed -- --dev",
    "db:token": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs scripts/db/create-token.ts",
    "budget:set": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs scripts/db/set-budget.ts",
    "worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs scripts/worker.ts",
    "test:e2e": "RUN_LIVE_E2E=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs --test src/backend/execution/research-worker.e2e.test.ts",
    "test:providers": "RUN_LIVE_PROVIDER_TESTS=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test/register.mjs --test --test-concurrency=1 src/backend/models/providers.e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@electric-sql/pglite": "0.5.15",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "openai": "7.49.0",
    "pg": "8.23.1",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
